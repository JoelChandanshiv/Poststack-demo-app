# Copy this file to backend.tf inside environments/prod, filling in
# <STATE_BUCKET_NAME> and <KMS_KEY_ARN> from bootstrap's outputs
# (`terraform output` inside bootstrap/ after it's applied).
#
# Note the key below: "prod/..." — this is what guarantees this directory's
# apply can never touch dev's state, since they're entirely separate objects
# in the same bucket.

terraform {
  backend "s3" {
    bucket       = "<STATE_BUCKET_NAME>"
    key          = "prod/terraform.tfstate"
    region       = "ap-south-2"
    encrypt      = true
    kms_key_id   = "<KMS_KEY_ARN>"

    # Native S3 state locking - Terraform 1.10+. No DynamoDB table required.
    use_lockfile = true
  }
}
